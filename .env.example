# ==============================================================================
# YouTube Toxic Comment Analyzer - Environment Configuration
# ==============================================================================

# Your Google Cloud YouTube Data API v3 Key
# Obtain for free at: https://console.cloud.google.com/apis/credentials
# Note: If no key is set, the application runs seamlessly in built-in bilingual demo mode.
YOUTUBE_API_KEY=your_youtube_data_api_key_here

# Server host and port configuration
HOST=127.0.0.1
PORT=5000
